{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "functions/**"],
    "rewrites": [
      { "source": "/post/**", "function": "postPreview" },
      { "source": "/post-image/**", "function": "postImage" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
