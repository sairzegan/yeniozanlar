{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/post/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|WhatsApp|LinkedInBot|TelegramBot|Discordbot|Googlebot|Pinterest|redditbot|vkShare|SkypeUriPreview|W3C_Validator).*"
        }
      ],
      "destination": "/api/postPreview?slug=:slug"
    },
    { "source": "/post/:slug", "destination": "/index.html" }
  ]
}
