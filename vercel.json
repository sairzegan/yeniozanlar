{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/post/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|twitterbot|slackbot|whatsapp|linkedinbot|telegrambot|discordbot|googlebot|pinterest|redditbot|vkshare|w3c_validator|skypeuripreview).*"
        }
      ],
      "destination": "/api/postPreview?slug=:slug"
    },
    { "source": "/post/:slug", "destination": "/index.html" }
  ]
}
