{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/post/:slug",
      "destination": "https://us-central1-yeniozanlar-68b49.cloudfunctions.net/postPreview?slug=:slug"
    }
  ]
}
